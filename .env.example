# Run scripts/deploy.sh on each target server, e.g. after connecting over SSH.
# It asks for ports/binds and generates that server's private credentials.
# It writes deploy/.env.local; it does not overwrite your existing .env.
HONEYPOT_BIND=0.0.0.0
# Elegido durante scripts/deploy.sh; no reutilizar el de otro honeypot.
HONEYPOT_PORT=
# Control API reachable from Central; restrict this port to Central in the
# server network. The socket uses HTTP, but control payloads are encrypted by
# the application with the deployment-specific API token.
API_BIND=0.0.0.0
HTTP_PORT=
VAIVAR_PORT_HONEYPOT=
VAIVAR_PORT_HTTP=
VAIVAR_HONEYPOT_PROFILE=
VAIVAR_SITE_ID=
# Nombre Compose estable y único para cada honeypot que comparta este host.
VAIVAR_COMPOSE_PROJECT=
# El canal de control cifra las peticiones/respuestas dentro de HTTP.
VAIVAR_CONTROL_CHANNEL=encrypted
VAIVAR_MASTER_SECRET=
VAIVAR_API_TOKEN=
# Register this server's domain/IP, HTTP_PORT, control channel and
# VAIVAR_API_TOKEN in Central.
# No central address or integration credentials are needed on the honeypot.

# Central console (docker-compose.central.yml). These are SEPARATE from the
# honeypot credentials: central has its own ingest/operator tokens and its own
# Splunk HEC credentials. Nodes never receive integration secrets.
# VAIVAR_CENTRAL_PORT=8080
# VAIVAR_CENTRAL_INGEST_TOKEN=
# VAIVAR_CENTRAL_OPERATOR_TOKEN=
# VAIVAR_CENTRAL_KEY=
# DATA_PATH=/data/vaivar-central
# VAIVAR_RELEASE_DIR=/data/vaivar-central/releases
#
# --- Splunk HEC export (opcional, en la central) ---
# VAIVAR_SPLUNK_HEC_URL=https://splunk.example.com:8088
# VAIVAR_SPLUNK_HEC_TOKEN=<HEC-token>
# VAIVAR_SPLUNK_HEC_INDEX=vaivar
# VAIVAR_SPLUNK_HEC_SOURCE=vaivar
# VAIVAR_SPLUNK_HEC_SOURCETYPE=vaivar:event
