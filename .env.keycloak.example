# Keycloak configuration for the vAIvar Central control plane.
# Copy this file to .env.keycloak (gitignored) and fill in real values.
# Do NOT commit secrets.

# --- Keycloak host ---
# Hostname that Central (and operators) use to reach Keycloak.
# Example: keycloak.vaivar.example.com or 10.0.0.5
KEYCLOAK_HOSTNAME=REPLACE_ME_keycloak-host

# --- Port mapping ---
# Host port exposed for Keycloak HTTP. Default 8081 does NOT collide
# with Central's 8080. Change only if 8081 is taken.
KEYCLOAK_HOST_PORT=8081

# --- Database (Postgres 16) ---
KEYCLOAK_POSTGRES_DB=vaivar-keycloak
KEYCLOAK_POSTGRES_USER=vaivar_keycloak
KEYCLOAK_POSTGRES_PASSWORD=REPLACE_ME_postgres-password

# --- Keycloak admin credentials ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME_admin-password

# --- OIDC client secret (for Central) ---
# The value that Central presents as VAIVAR_OIDC_CLIENT_SECRET. It must match
# the vaivar-central client Secret stored in Keycloak (set in
# keycloak/realm-vaivar.json before first boot, or changed later in the admin
# console Credentials tab). Generate a strong random string, e.g.:
#   openssl rand -hex 32
VAIVAR_OIDC_CLIENT_SECRET=REPLACE_ME_oidc-client-secret
