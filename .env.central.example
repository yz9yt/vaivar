# Central control plane configuration.
# Copy this file to .env.central (gitignored) and fill in real values.
# Do NOT commit secrets.

# Bind address for the central HTTP API (0.0.0.0 for all interfaces).
CENTRAL_BIND=0.0.0.0

# Port exposed on the host for the central dashboard and API.
CENTRAL_PORT=8080

# Port exposed for the central dashboard and API.
VAIVAR_CENTRAL_PORT=8080

# Token edges present when pushing events to /api/v1/events.
# Must be at least 16 characters.
VAIVAR_CENTRAL_INGEST_TOKEN=replace-me-ingest-token

# Token the operator dashboard/UI presents for login.
# Set to "dev" to disable auth (local dev only).
VAIVAR_CENTRAL_OPERATOR_TOKEN=replace-me-operator-token

# Auth mode for the Central dashboard and API.
# Allowed values: none | legacy | oidc
# - none: no authentication required (open dashboard, for local dev/tests)
# - legacy: legacy token auth using VAIVAR_CENTRAL_OPERATOR_TOKEN / VAIVAR_CENTRAL_ADMIN_TOKEN
# - oidc: OpenID Connect (Keycloak) SSO with RBAC
# Default: none
VAIVAR_CENTRAL_AUTH_MODE=none

# Admin token for node enrollment and management.
VAIVAR_CENTRAL_ADMIN_TOKEN=replace-me-admin-token

# Superadmin token (total control: manages accounts, system config).
# Optional. If set, it seeds a `superadmin` account at boot (RBAC).
VAIVAR_CENTRAL_SUPERADMIN_TOKEN=replace-me-superadmin-token

# Central encryption key (64+ hex chars). Generate once and persist.
# If empty, the server will refuse to start in persistent mode.
VAIVAR_CENTRAL_KEY=

# Data directory for SQLite and secrets (mounted as a volume in production).
DATA_PATH=/data/vaivar-central

# Directory where the central-approved honeypot release bundles are copied.
# Keep it inside the persistent DATA_PATH volume unless you deliberately use
# a separate read-only release mount.
VAIVAR_RELEASE_DIR=/data/vaivar-central/releases
# Host directory bind-mounted read-only at VAIVAR_RELEASE_DIR. The publisher
# can write the artifact and manifest here; Central discovers them per request.
VAIVAR_RELEASE_HOST_DIR=./releases

# Optional Splunk HEC export (leave empty to disable).
VAIVAR_SPLUNK_HEC_URL=
VAIVAR_SPLUNK_HEC_TOKEN=
VAIVAR_SPLUNK_HEC_INDEX=vaivar
VAIVAR_SPLUNK_HEC_SOURCE=vaivar

# Polling interval in milliseconds (default 30000).
VAIVAR_POLL_INTERVAL_MS=30000
